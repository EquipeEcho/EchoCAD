# Caminho para o código fonte do backend
PYTHONPATH=src

# Porta do MySQL/MariaDB exposta no host
MYSQL_HOST_PORT=3307
# Porta do backend exposta para desenvolvimento
API_PORT=8001
# Porta do frontend exposta no host
FRONTEND_PORT=80
# Porta interna do frontend (deve coincidir com a porta configurada no Cloudflare Tunnel)
FRONTEND_INTERNAL_PORT=81

# Configuração do banco de dados (MariaDB)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=echocad
MYSQL_PASSWORD=echocad_password
MYSQL_DATABASE=echocad_db
MYSQL_INITDB_SKIP_TZINFO=yes

# URL de conexão usada pelo SQLAlchemy (local):
# Para uso fora do Docker, o banco local deve ser acessado via localhost.
# Deve ser consistente com MYSQL_USER, MYSQL_PASSWORD e MYSQL_DATABASE
DATABASE_URL=mysql+pymysql://echocad:echocad_password@localhost:3306/echocad_db
DATABASE_ASYNC_URL=mysql+aiomysql://echocad:echocad_password@localhost:3306/echocad_db

# Configuração de autenticação JWT
JWT_TOKEN=super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Configurações da Aplicação
LOG_LEVEL=INFO
ECHO_DATABASE=True
GROQ_API_KEY=gsk_REPLACE_ME

# Modo de depuração local
DEBUG=False

# Cloudflared
CLOUDFLARED_TOKEN=
