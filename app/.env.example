# Caminho para o código fonte do backend
PYTHONPATH=src

# Porta do MySQL/MariaDB exposta no host (para clientes externos ao Docker)
MYSQL_HOST_PORT=3307
# Porta do backend exposta no host
API_PORT=8001
# Porta do frontend exposta no host
FRONTEND_PORT=80
# Porta interna do Nginx no container do frontend
FRONTEND_INTERNAL_PORT=81

# Configuração do banco de dados (MariaDB)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=echocad
MYSQL_PASSWORD=echocad_password
MYSQL_DATABASE=echocad_db
MYSQL_INITDB_SKIP_TZINFO=yes

# URL de conexão usada pelo SQLAlchemy
# Em Docker, usar o nome do serviço como host: mariadb
# Em desenvolvimento local, substituir por localhost:<MYSQL_HOST_PORT>
DATABASE_URL=mysql+pymysql://echocad:echocad_password@mariadb:3306/echocad_db
DATABASE_ASYNC_URL=mysql+aiomysql://echocad:echocad_password@mariadb:3306/echocad_db

# Configuração de autenticação JWT
JWT_TOKEN=super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Configurações da Aplicação
LOG_LEVEL=INFO
ECHO_DATABASE=False
DEBUG=False

# Groq AI
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=5
GROQ_TIMEOUT_SECONDS=100.0

# Ollama AI (ativo apenas com --profile ollama)
# Em Docker: OLLAMA_URL=http://ollama:11434
# Em dev local: OLLAMA_URL=http://localhost:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120.0

# CORS — origens permitidas (JSON array)
CORS_ORIGINS=["http://localhost","http://localhost:80","https://echocad.hermeticshell.org"]

# Cloudflared
CLOUDFLARED_TOKEN=
