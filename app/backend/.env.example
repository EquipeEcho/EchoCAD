# Caminho para o código fonte do backend
PYTHONPATH=src

# Porta do MySQL/MariaDB exposta no host
MYSQL_HOST_PORT=3306

# Configuração do banco de dados (MariaDB)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=echocad
MYSQL_PASSWORD=echocad_password
MYSQL_DATABASE=echocad_db
MYSQL_INITDB_SKIP_TZINFO=yes

# URL de conexão usada pelo SQLAlchemy (pode usar mysql+pymysql ou mariadb+pymysql)
DATABASE_URL=mysql+pymysql://echocad:echocad_password@mariadb:3306/echocad_db
DATABASE_ASYNC_URL=mysql+asyncmy://echocad:echocad_password@mariadb:3306/echocad_db

# Configuração de autenticação JWT
JWT_TOKEN=super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Configurações da Aplicação
LOG_LEVEL=INFO
ECHO_DATABASE=True
GROQ_API_KEY=gsk_REPLACE_ME

# Modo de depuração local
DEBUG=False
