# Caminho para o código fonte do backend
PYTHONPATH=src

# Porta do MySQL/MariaDB exposta no host
# A exposição dessa porta é útil para conectar clientes externos ao banco de dados
MYSQL_HOST_PORT=3307

# Porta do backend exposta para desenvolvimento
API_PORT=8001

# Configuração do banco de dados (MariaDB)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=echocad
MYSQL_PASSWORD=echocad_password
MYSQL_DATABASE=echocad_db
MYSQL_INITDB_SKIP_TZINFO=yes

# URL de conexão com o banco de dados (dev local — banco em localhost)
# Em Docker, trocar localhost:<MYSQL_HOST_PORT> por mariadb:3306
DATABASE_URL=mysql+pymysql://echocad:echocad_password@localhost:3307/echocad_db
DATABASE_ASYNC_URL=mysql+aiomysql://echocad:echocad_password@localhost:3307/echocad_db

# Configuração de autenticação JWT
JWT_TOKEN=super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Configurações de logging
LOG_LEVEL=INFO
ECHO_DATABASE=True
DEBUG=False

# Groq AI
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=5
GROQ_TIMEOUT_SECONDS=100.0

# Ollama AI (dev local — Ollama rodando em localhost)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120.0

# CORS (dev local)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
