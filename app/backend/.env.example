# EchoCAD Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# Python Configuration
PYTHONPATH=src

# Database Configuration
database_url='mysql+pymysql://echocad_admin:echocad_admin_password@localhost:3306/echocad_db'

# Application Configuration
debug=False

# When using Docker: change 'localhost' to 'mysql'
# database_url='mysql+pymysql://echocad_admin:echocad_admin_password@mysql:3306/echocad_db'

# API Keys (add as needed)
# GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration
# OLLAMA_BASE_URL=http://localhost:11434
# (or use http://ollama:11434 when in Docker)
