# Caminho para o código fonte do backend
PYTHONPATH=src

# Porta do MySQL/MariaDB exposta no host
# A exposição dessa porta é útil para conectar clientes externos ao banco de dados
# como o mysql workbench ou dbeaver ou similares.
MYSQL_HOST_PORT=3306

# Porta do backend exposta para desenvolvimento, serve para testes locais direto no navegador
API_PORT=8000

# Configuração do banco de dados (MariaDB)
# Essas configurações são mantidas para a criação do banco de dados
# A configuração de conexão encontra-se disponível abaixo; para fins práticos, os nomes devem ser
# mantidos iguais para o usuário, senha, endereço e porta.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=echocad
MYSQL_PASSWORD=echocad_password
MYSQL_DATABASE=echocad_db
MYSQL_INITDB_SKIP_TZINFO=yes

# URL de conexão com o banco de dados
# Uma URL síncrona para o Alembic aplicar a migração e uma URL assíncrona para uso em produção.
DATABASE_URL=mysql+pymysql://echocad:echocad_password@localhost:3306/echocad_db
DATABASE_ASYNC_URL=mysql+aiomysql://echocad:echocad_password@localhost:3306/echocad_db

# Configuração de autenticação JWT
JWT_TOKEN=super_secret_jwt_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Configurações de logging para depuração da aplicação.
LOG_LEVEL=INFO
ECHO_DATABASE=True
GROQ_API_KEY=gsk_REPLACE_ME

# Modo de depuração local
DEBUG=False
